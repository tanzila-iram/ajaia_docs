<div class="mx-auto max-w-6xl px-6 py-10">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Documents</h1>
      <p class="mt-1 text-gray-600">Create and manage your documents.</p>
    </div>

    <%= link_to "New document",
          new_document_path,
          class: "rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white hover:bg-blue-700" %>
  </div>

  <% if @documents.any? %>
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <% @documents.each do |document| %>
        <div class="flex items-center justify-between border-b border-gray-100 px-6 py-5 last:border-b-0">
          <div>
            <%= link_to document.title,
                  document,
                  class: "text-lg font-semibold text-gray-900 hover:text-blue-600" %>

            <p class="mt-1 text-sm text-gray-500">
              Updated <%= time_ago_in_words(document.updated_at) %> ago
            </p>
          </div>

          <div class="flex items-center gap-3">
            <%= link_to "Edit",
                  edit_document_path(document),
                  class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>

            <%= button_to "Delete",
                  document_path(document),
                  method: :delete,
                  form: {
                    data: {
                      turbo_confirm: "Are you sure you want to delete this document?"
                    }
                  },
                  class: "text-sm font-medium text-red-600 hover:text-red-800" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">
      <h2 class="text-xl font-semibold text-gray-900">No documents yet</h2>

      <p class="mt-2 text-gray-600">
        Create your first document to get started.
      </p>

      <%= link_to "Create document",
            new_document_path,
            class: "mt-6 inline-block rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
