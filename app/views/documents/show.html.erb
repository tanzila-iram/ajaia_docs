<div class="mx-auto max-w-4xl px-6 py-10">
  <div class="mb-8 flex items-start justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <%= @document.title %>
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Owned by <%= @document.owner.name %>
        · Updated <%= time_ago_in_words(@document.updated_at) %> ago
      </p>
    </div>

    <div class="flex gap-3">
      <%= link_to "Edit",
            edit_document_path(@document),
            class: "rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" %>

      <% if @document.owner == current_user %>
        <%= button_to "Delete",
              document_path(@document),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "Are you sure you want to delete this document?"
                }
              },
              class: "rounded-lg bg-red-600 px-4 py-2 font-medium text-white hover:bg-red-700" %>
      <% end %>

      <%= link_to "Back",
            documents_path,
            class: "rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>

  <article class="prose max-w-none rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
    <%= @document.content %>
  </article>

  <hr class="my-8">

  <% if @document.owner == current_user %>

    <div class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

      <h2 class="text-xl font-semibold mb-4">
        Share Document
      </h2>

      <% if @available_users.any? %>

        <%= form_with model: [@document, DocumentShare.new] do |form| %>

          <div class="flex items-end gap-4">

            <div class="flex-1">
              <%= form.label :user_id, "Select User",
                    class: "block text-sm font-medium text-gray-700 mb-2" %>

              <%= form.collection_select :user_id,
                    @available_users,
                    :id,
                    :name,
                    { prompt: "Choose a user" },
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2" %>
            </div>

            <%= form.submit "Share",
                  class: "rounded-lg bg-blue-600 px-5 py-2 text-white hover:bg-blue-700 cursor-pointer" %>

          </div>

        <% end %>

      <% else %>

        <p class="text-gray-500">
          This document has already been shared with everyone.
        </p>

      <% end %>

    </div>

  <% end %>


  <h2 class="text-xl font-semibold mb-4">
    People with Access
  </h2>

  <div class="space-y-3">
    <div class="flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3">
      <div>
        <p class="font-medium"><%= @document.owner.name %></p>
        <p class="text-sm text-gray-500">Owner</p>
      </div>
    </div>

    <% @document.document_shares.includes(:user).each do |share| %>
      <div class="flex items-center justify-between rounded-lg border border-gray-200 px-4 py-3">
        <div>
          <p class="font-medium"><%= share.user.name %></p>
          <p class="text-sm text-gray-500">Can edit</p>
        </div>

        <% if @document.owner == current_user %>
          <%= button_to "Remove",
                document_document_share_path(@document, share),
                method: :delete,
                form: {
                  data: {
                    turbo_confirm: "Remove access for #{share.user.name}?"
                  }
                },
                class: "text-red-600 hover:text-red-800 text-sm font-medium" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
