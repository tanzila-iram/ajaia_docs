<div class="mx-auto max-w-4xl px-6 py-10">
  <div class="mb-8 flex items-start justify-between gap-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">
        <%= @document.title %>
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Owned by <%= @document.owner.name %>
        · Updated <%= time_ago_in_words(@document.updated_at) %> ago
      </p>
    </div>

    <div class="flex gap-3">
      <%= link_to "Edit",
            edit_document_path(@document),
            class: "rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700" %>

      <%= link_to "Back",
            documents_path,
            class: "rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>

  <article class="prose max-w-none rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
    <%= @document.content %>
  </article>
</div>
